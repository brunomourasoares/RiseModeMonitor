<UserControl x:Class="RiseModeMonitor.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Hardware" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Master: hardware list -->
            <ListBox ItemsSource="{Binding Hardware}" SelectedItem="{Binding Selected}"
                     ItemContainerStyle="{StaticResource NavItemStyle}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,20,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="{Binding Indent}">
                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Text="{Binding KindLabel}" FontSize="11" Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Detail: search + grouped sensors -->
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Search sensors" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" FontSize="14"
                             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource LineBrush}" CaretBrush="{DynamicResource TextBrush}" />
                </StackPanel>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Sensor" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="1" Text="Value" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="Min" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Grid.Column="3" Text="Max" FontSize="11" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Sensors}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Min}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Max}" TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="No sensors to show." Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
