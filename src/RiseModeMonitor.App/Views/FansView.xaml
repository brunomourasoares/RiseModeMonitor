<UserControl x:Class="RiseModeMonitor.Views.FansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RiseModeMonitor.ViewModels"
             xmlns:loc="clr-namespace:RiseModeMonitor.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Every fan card has exactly the same size; channels with nothing spinning on them are hidden. -->
        <Style x:Key="FanCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="270" />
            <Setter Property="Height" Value="252" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NoFanNote" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Right margin: the scrollbar floats over the content, so keep it clear of the cards. -->
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="{loc:Loc Nav_Fans}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />

            <TextBlock Text="{loc:Loc Fans_Intro}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Loc Fans_HowTo}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Margin="0,8,0,0" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{loc:Loc Fans_Warning}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Margin="0,8,0,12" Foreground="{DynamicResource AccentBrush}" />

            <Button Content="{loc:Loc Fans_RestoreAll}" Command="{Binding RestoreAllCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,16" Padding="14,8" />

            <TextBlock Text="{loc:Loc Fans_None}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <!-- Cards flow left to right and wrap to the next row when the window is too narrow. -->
            <ItemsControl ItemsSource="{Binding Channels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FanCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Editable name: type your own or pick a suggestion; saved when the field loses focus. -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                    <ComboBox IsEditable="True" MinHeight="30" Padding="6,3" FontSize="14" FontWeight="SemiBold"
                                              ItemsSource="{x:Static vm:FansViewModel.SuggestedNames}"
                                              Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                              ToolTip="{loc:Loc Fans_RenameTip}" />
                                    <TextBlock FontSize="11" Margin="2,2,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding HardwareName, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RpmText}" FontSize="18"
                                           FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,4,0,0" />

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                           Text="{loc:Loc Fans_NoFan}" Style="{StaticResource NoFanNote}"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                          IsChecked="{Binding IsManual}" IsEnabled="{Binding IsConnected}"
                                          Content="{loc:Loc Fans_Manual}" />

                                <Slider Grid.Row="3" Grid.Column="0" Margin="0,8,12,0" VerticalAlignment="Center"
                                        Minimum="{Binding MinPercent}" Maximum="{Binding MaxPercent}"
                                        Value="{Binding Percent, Delay=200}" IsEnabled="{Binding IsManual}"
                                        SmallChange="1" LargeChange="5" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Center"
                                           Text="{Binding Percent, StringFormat={}{0:0} %}" />

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                    <TextBlock Text="{loc:Loc Fans_Reported}" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding ReportedPercentText}" FontSize="12" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
