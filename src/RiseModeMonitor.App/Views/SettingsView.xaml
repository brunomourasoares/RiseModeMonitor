<UserControl x:Class="RiseModeMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Theme" FontWeight="SemiBold" />
                <TextBlock Text="System follows the Windows app mode." Margin="0,2,0,12"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" FontSize="14" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <TextBlock Text="More options (language, autostart, water cooler display) coming soon." Margin="0,16,0,0"
                   Foreground="{DynamicResource TextMutedBrush}" />
    </StackPanel>
</UserControl>
