<UserControl x:Class="RiseModeMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RiseModeMonitor.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- One fixed width for the whole page, so every card has exactly the same size. -->
        <StackPanel Width="580" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Nav_Settings}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_Theme}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings_ThemeHint}" Margin="0,2,0,12"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_Language}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Settings_LanguageHint}" Margin="0,2,0,12"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    <ListBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_Display}" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding DisplayEnabled}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_DisplayEnabled}" />
                            <TextBlock Text="{loc:Loc Settings_DisplayHint}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Alerts: bound to SettingsViewModel.Alerts -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding Alerts}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_Alerts}" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Alerts_Hint}" TextWrapping="Wrap" Margin="0,2,0,12" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <CheckBox IsChecked="{Binding CpuEnabled}" Content="{loc:Loc Alerts_Cpu}" />
                    <Grid Margin="0,6,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="50" Maximum="105" SmallChange="1" LargeChange="5"
                                Value="{Binding CpuThreshold}" IsEnabled="{Binding CpuEnabled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding CpuThreshold, StringFormat={}{0:0} &#176;C}" />
                    </Grid>

                    <CheckBox IsChecked="{Binding GpuEnabled}" Content="{loc:Loc Alerts_Gpu}" />
                    <Grid Margin="0,6,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="50" Maximum="105" SmallChange="1" LargeChange="5"
                                Value="{Binding GpuThreshold}" IsEnabled="{Binding GpuEnabled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding GpuThreshold, StringFormat={}{0:0} &#176;C}" />
                    </Grid>

                    <CheckBox IsChecked="{Binding FanStoppedEnabled}" Content="{loc:Loc Alerts_FanStopped}" Margin="0,0,0,12" />

                    <TextBlock Text="{loc:Loc Alerts_Sound}" Margin="0,0,0,4" />
                    <ListBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedSound}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{loc:Loc Alerts_Volume}" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                Value="{Binding Volume}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Volume, StringFormat={}{0:0} %}" />
                    </Grid>

                    <Button Content="{loc:Loc Alerts_Test}" Command="{Binding TestSoundCommand}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,8" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings_Startup}" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows}" />
                            <TextBlock Text="{loc:Loc Settings_StartWithWindowsHint}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding StartMinimized}" Content="{loc:Loc Settings_StartMinimized}" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding CloseToTray}" Content="{loc:Loc Settings_CloseToTray}" />

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
