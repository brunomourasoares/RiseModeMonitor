<UserControl x:Class="RiseModeMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:RiseModeMonitor.Localization">
    <UserControl.Resources>
        <Style x:Key="CardIcon" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowIcon" TargetType="Path" BasedOn="{StaticResource CardIcon}">
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="auto" HorizontalAlignment="Left" Margin="0,0,12,0">
            <TextBlock Text="{loc:Loc Nav_Settings}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- Theme -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Palette}" />
                            <TextBlock Text="{loc:Loc Settings_Theme}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Settings_ThemeHint}" Style="{StaticResource HintText}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                             Grid.Column="2" VerticalAlignment="Center" Width="150">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="14" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Language -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Globe}" />
                            <TextBlock Text="{loc:Loc Settings_Language}" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock Text="{loc:Loc Settings_LanguageHint}" Style="{StaticResource HintText}" />
                    </StackPanel>

                    <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                             Grid.Column="2" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>
            
            <!-- Startup and tray -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.PowerOff}" />
                        <TextBlock Text="{loc:Loc Settings_Startup}" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_StartWithWindows}" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc Settings_StartWithWindowsHint}" Style="{StaticResource HintText}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}"
                                         VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_StartMinimized}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimized}"
                                         VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings_CloseToTray}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}"
                                         VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Water cooler display -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Microchip}" />
                        <TextBlock Text="{loc:Loc Settings_Display}" Style="{StaticResource CardTitle}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Settings_DisplayEnabled}" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc Settings_DisplayHint}" Style="{StaticResource HintText}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding DisplayEnabled}"
                                         VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Alerts -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" DataContext="{Binding Alerts}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource CardIcon}" Data="{StaticResource Icon.Alert}" />
                        <TextBlock Text="{loc:Loc Settings_Alerts}" Style="{StaticResource CardTitle}" />
                    </StackPanel>
                    <TextBlock Text="{loc:Loc Alerts_Hint}" Style="{StaticResource HintText}" Margin="0,6,0,16" />

                    <!-- CPU -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Alerts_Cpu}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,0,0" />
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding CpuEnabled}"
                                         VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="50" Maximum="100" SmallChange="1" LargeChange="5"
                                Value="{Binding CpuThreshold}" IsEnabled="{Binding CpuEnabled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding CpuThreshold, StringFormat={}{0:0} &#176;C}" />
                    </Grid>

                    <!-- GPU -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Alerts_Gpu}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,0,0" />
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding GpuEnabled}"
                                         VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>
                    <Grid Margin="0,6,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="50" Maximum="100" SmallChange="1" LargeChange="5"
                                Value="{Binding GpuThreshold}" IsEnabled="{Binding GpuEnabled}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding GpuThreshold, StringFormat={}{0:0} &#176;C}" />
                    </Grid>

                    <!-- Fan stopped -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{loc:Loc Alerts_FanStopped}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,0,0" />
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding FanStoppedEnabled}"
                                         VerticalAlignment="Center" Margin="16,0,0,0" />
                    </Grid>

                    <!-- Sound -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{loc:Loc Alerts_Sound}" Margin="0,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding SelectedSound}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Volume -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                        <TextBlock Text="{loc:Loc Alerts_Volume}" Margin="0,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                Value="{Binding Volume}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Volume, StringFormat={}{0:0} %}" />
                    </Grid>

                    <!-- Alarm duration -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                        <TextBlock Text="{loc:Loc Alerts_Duration}" Margin="0,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="5" Maximum="120" SmallChange="1" LargeChange="5"
                                Value="{Binding SoundDuration}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding SoundDuration, StringFormat={}{0:0} s}" />
                    </Grid>
                    <Button HorizontalAlignment="Left" Margin="0,16,0,0" Padding="14,8"
                            Command="{Binding TestSoundCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Play}" Fill="{DynamicResource TextBrush}"
                                  Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Alerts_Test}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>