<UserControl x:Class="RiseModeMonitor.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                    <TextBlock Text="System follows the Windows app mode." Margin="0,2,0,12"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ListBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Startup and tray" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Text="Runs as administrator without a UAC prompt (scheduled task)."
                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding StartMinimized}" Content="Start minimized to the system tray" Margin="0,0,0,8" />
                    <CheckBox IsChecked="{Binding CloseToTray}" Content="Close button hides the app to the system tray" />

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="More options (language, water cooler display) coming soon." Margin="0,4,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
