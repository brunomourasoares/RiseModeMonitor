<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Light variant (the site is dark-only, so this is derived): same blue accent
        (--color-rise-blue #1E7FFF / hover #3D86FF) over neutral light surfaces.
        Must define the same keys as Dark.xaml.
    -->
    <SolidColorBrush x:Key="DeepBrush" Color="#E3E6EC" />
    <SolidColorBrush x:Key="BgBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E9ECF1" />
    <SolidColorBrush x:Key="LineBrush" Color="#D5DAE1" />
    <SolidColorBrush x:Key="TextBrush" Color="#14171C" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5B6472" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1E7FFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D86FF" />
</ResourceDictionary>
