<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Background #0B0F19 is the Rise Mode site theme-color. -->
    <!-- TODO: confirm AccentBrush (and text colors) with the official Rise Mode brand palette. -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B0F19" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121826" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A2233" />
    <SolidColorBrush x:Key="LineBrush" Color="#232C40" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F4FA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8F9BB3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#E5383B" />
</ResourceDictionary>
