<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Palette from the risemode.com CSS tokens:
          --color-rise-black   #060709   --color-rise-dark   #0B0C10   --color-rise-darker #0E1016
          --color-rise-gray    #14161C   --color-rise-light  #20242E   --color-rise-lighter #2B3040
          --color-rise-blue    #1E7FFF   --color-rise-blue-hover #3D86FF
          --color-rise-text    #ECEEF2   --color-rise-text-muted #8E94A3
        How the site uses each token is not confirmed; the mapping below follows the token names
        (a dark elevation scale + one blue accent). Adjust here if it looks different from the site.
    -->
    <SolidColorBrush x:Key="DeepBrush" Color="#060709" />
    <SolidColorBrush x:Key="BgBrush" Color="#0B0C10" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14161C" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#20242E" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B3040" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEEF2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E94A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1E7FFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D86FF" />
</ResourceDictionary>
