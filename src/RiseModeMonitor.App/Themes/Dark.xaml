<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Palette from the risemode.com CSS tokens (color-rise-*):
          black #060709, dark #0B0C10, darker #0E1016, gray #14161C, light #20242E, lighter #2B3040,
          blue #1E7FFF, blue-hover #3D86FF, text #ECEEF2, text-muted #8E94A3.
        How the site uses each token is not confirmed; the mapping below follows the token names
        (a dark elevation scale plus one blue accent). Adjust here if it looks different from the site.
        NOTE: never put two consecutive hyphens inside an XML comment, it breaks the XAML build.
    -->
    <SolidColorBrush x:Key="DeepBrush" Color="#060709" />
    <SolidColorBrush x:Key="BgBrush" Color="#0B0C10" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14161C" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#20242E" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B3040" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEEF2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E94A3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1E7FFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D86FF" />
</ResourceDictionary>
