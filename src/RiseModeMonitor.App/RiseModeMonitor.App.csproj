<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the tray NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RiseModeMonitor</AssemblyName>
    <RootNamespace>RiseModeMonitor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avoid WPF/WinForms type ambiguities (Application, Button, Color...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RiseModeMonitor.Core\RiseModeMonitor.Core.csproj" />
    <ProjectReference Include="..\RiseModeMonitor.Hardware\RiseModeMonitor.Hardware.csproj" />
  </ItemGroup>
</Project>
