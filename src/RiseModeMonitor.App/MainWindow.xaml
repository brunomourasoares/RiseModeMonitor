<ui:FluentWindow x:Class="RiseModeMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:RiseModeMonitor.ViewModels"
        xmlns:views="clr-namespace:RiseModeMonitor.Views"
        Title="Rise Mode Monitor" Height="720" Width="1180" MinHeight="560" MinWidth="900"
        Icon="pack://application:,,,/Resources/Images/rise-monitor.ico"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <ui:FluentWindow.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}">
            <views:HardwareView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FansViewModel}">
            <views:FansView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Rise Mode Monitor" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="242" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Same card look as the rest of the app: full border, rounded corners, a gap to the window edges. -->
            <Border Style="{StaticResource Card}" Margin="12,4,0,12" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,24">
                        <Image Source="/Resources/Images/rise-monitor-256.png" Width="30" Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="RISE MODE" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" FontSize="14" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Margin="28" Content="{Binding Selected.ViewModel}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
